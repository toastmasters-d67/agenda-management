# vm-postgen-prod 的 /srv/club-management/.env 範本。
# 實際內容整份存在 GitHub → Settings → Environments → production 的
# PROD_ENV_FILE secret，每次部署由 workflow 覆寫到 VM 上。不要把真值進版控。
# IMAGE_TAG 由 remote-deploy.sh 寫入，這裡不用填。

# --- 資料庫（compose 的 db 容器；DATABASE_URL 由 docker-compose.yml 組出）
POSTGRES_DB=agenda
POSTGRES_USER=agenda
# openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- 對外網址（子路徑部署）
PUBLIC_ORIGIN=https://postgen-d67.eastasia.cloudapp.azure.com
PUBLIC_BASE_URL=https://postgen-d67.eastasia.cloudapp.azure.com/club-management

# --- 必填
# 前端 middleware 與 FastAPI 共用
JWT_SECRET=
# openssl rand -base64 32；換掉會讓已存的金鑰全部失效
CREDENTIALS_SECRET_KEY=
# 必須和 JWT_SECRET 不同
MCP_TOKEN_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- 選填：Microsoft 登入（不設就不顯示 Microsoft 按鈕）
MS_CLIENT_ID=
MS_CLIENT_SECRET=

DB_POOL_MAX=10

# 不設定：META_APP_ID / META_APP_SECRET、THREADS_APP_ID / THREADS_APP_SECRET、
# ANTHROPIC_API_KEY。這些是「全站共用」的退路；正式站的設計是各分會在
# 分會管理填自己的 App，使用者／分會填自己的 AI 金鑰。
