# FastAPI backend + Alembic migrations.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
# Word -> PDF / JPG for clubs with their own Word template (/api/word-render):
# LibreOffice lays the .docx out, poppler cuts the pages into JPGs. Noto CJK is
# what Chinese text is set in, Noto Color Emoji covers emoji, Liberation stands
# in for Arial / Times, and the fontconfig aliases send Windows font names
# (微軟正黑體 …) to Noto.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui fonts-noto-cjk fonts-noto-color-emoji fonts-liberation poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/fonts/99-agenda-fonts.conf /etc/fonts/conf.d/99-agenda-fonts.conf
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY api ./api
# The JSON files the backend shares with the frontend (role catalog, platform
# rules). api/index.py reads them at import, so without them the API exits on start.
COPY lib/meetingRoles.json lib/socialPlatforms.json ./lib/
COPY migrations ./migrations
COPY alembic.ini ./
RUN useradd --create-home app
USER app
EXPOSE 8001
# Only nginx (via the 127.0.0.1-bound port) and the web container reach this,
# so trusting X-Forwarded-* from any peer is safe.
CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8001", \
     "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
