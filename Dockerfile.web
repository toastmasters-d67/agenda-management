# Next.js frontend — standalone build (next.config.mjs: output 'standalone').
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Baked into the client bundle at build time (see lib/basePath.js).
ARG NEXT_PUBLIC_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
# Headless Chromium for /svc/agenda-export (MCP export_agenda: agenda → PDF/JPG).
# The Chromium bundled in node_modules is an Amazon Linux build for Vercel and
# does not run on Alpine, so the distro's is used, with CJK and emoji fonts —
# without them every 中文 glyph on the agenda renders as an empty box.
# Alpine has shipped the binary as both chromium-browser and chromium; link
# whichever exists to one fixed path so the env var below cannot go stale.
RUN apk add --no-cache chromium font-noto-cjk font-noto-emoji \
 && ln -s "$(command -v chromium-browser || command -v chromium)" /usr/local/bin/agenda-chromium \
 && /usr/local/bin/agenda-chromium --version
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    CHROME_EXECUTABLE_PATH=/usr/local/bin/agenda-chromium
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
